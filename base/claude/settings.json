{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "3",
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "20",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker logs *)",
      "Bash(docker ps *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git worktree list *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mypy *)",
      "Bash(nl *)",
      "Bash(pyright *)",
      "Bash(rg *)",
      "Bash(ruff check *)",
      "Bash(ruff format --check *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)"
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "tui": "fullscreen"
}
